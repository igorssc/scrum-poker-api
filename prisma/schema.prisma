generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum StatusRoom {
  OPEN
  CLOSED
}

enum StatusMember {
  PENDING
  LOGGED
  REFUSED
}

model User {
  id           String       @id @default(uuid())
  name         String
  created_at   DateTime     @default(now())
  rooms        Room[]
  members      Member[]
  vote_details VoteDetail[]

  @@map("users")
}

model Room {
  id                     String     @id @default(uuid())
  name                   String
  owner_id               String
  created_at             DateTime   @default(now())
  theme                  String
  status                 StatusRoom
  lat                    Float?
  lng                    Float?
  private                Boolean
  access                 String     @default(uuid())
  cards_open             Boolean    @default(false)
  who_can_edit           String[]   @default([])
  who_can_open_cards     String[]   @default([])
  who_can_aprove_entries String[]   @default([])
  start_timer            DateTime?
  stop_timer             DateTime?
  auto_grant_permissions Boolean    @default(false)
  last_activity          DateTime   @default(now())
  current_issue          String?
  current_sector         String?

  owner   User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  members Member[]
  votes   Vote[]

  @@map("rooms")
}

model Member {
  id         String       @id @default(uuid())
  user_id    String
  room_id    String
  vote       String?
  created_at DateTime     @default(now())
  status     StatusMember @default(PENDING)

  member User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  room   Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("members")
}

model Vote {
  id              String    @id @default(uuid())
  room_id         String
  topic           String
  sector          String
  created_at      DateTime  @default(now())
  finalized_at    DateTime?
  total_duration  Int?
  final_consensus String?

  room          Room          @relation(fields: [room_id], references: [id], onDelete: Cascade)
  voting_rounds VotingRound[]

  @@map("votes")
}

model VotingRound {
  id           String   @id @default(uuid())
  vote_id      String
  voted_at     DateTime @default(now())
  duration     Int?
  consensus    String?
  winner_cards String[] @default([])

  votes VoteDetail[]
  vote  Vote         @relation(fields: [vote_id], references: [id], onDelete: Cascade)

  @@map("voting_rounds")
}

model VoteDetail {
  id              String   @id @default(uuid())
  voting_round_id String
  user_id         String
  card            String
  created_at      DateTime @default(now())

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voting_round VotingRound @relation(fields: [voting_round_id], references: [id], onDelete: Cascade)

  @@map("vote_details")
}
